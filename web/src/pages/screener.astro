---
import Base from '../layouts/Base.astro';
import Screener from '../components/Screener.tsx';
import { loadMetrics, isDemo } from '../lib/screener';

const data = loadMetrics();
const demo = isDemo();
const count = data.count ?? data.stocks.length;
const mtf = data.mtf_eligible_count ?? data.stocks.filter((s) => s.mtf_eligible).length;
const updated = data.ts ? new Date(data.ts).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) : 'awaiting first run';
const hasAi = Boolean(data.ai);
// the full universe is emitted by src/pages/screener-data.json.ts; the island
// fetches it client-side so ~7 MB isn't inlined into this HTML.
---

<Base
  active="screener"
  title="Screener — rank every Indian stock by return potential | Nifty Signal"
  desc="Client-side screener over ~5,800 Indian stocks. Rank by a combined return-potential composite, re-weight the factors with weighting profiles, and read after-tax MTF buy-and-hold returns. Backend-free, shareable."
>
  <header class="hero wrap">
    <div class="hero-copy">
      <span class="kicker">Indian equity · return-potential screener</span>
      <h1>Rank the market by <span class="hl">return potential</span>.</h1>
      <p class="sub">Every listed Indian stock, scored on a single composite that blends value, growth, quality, momentum and analyst upside. Pick a <b>weighting profile</b>, re-weight the factors live, and read the <b>after-tax MTF buy-and-hold</b> return. Runs entirely in your browser.</p>
    </div>
    <dl class="stat-row">
      <div class="stat"><dt>Universe</dt><dd>{count.toLocaleString('en-IN')}</dd><span>listed stocks</span></div>
      <div class="stat"><dt>MTF-eligible</dt><dd>{mtf.toLocaleString('en-IN')}</dd><span>F&amp;O names</span></div>
      <div class="stat"><dt>Updated</dt><dd class="ts">{updated}</dd><span>{demo ? 'demo' : 'daily'}</span></div>
    </dl>
  </header>

  <main class="wrap">
    <Screener demo={demo} hasAi={hasAi} client:load />
  </main>

  <footer>
    <div class="wrap">
      <span>Not investment or tax advice — a screen, not a recommendation. Low multiples ≠ cheap; leverage can lose more than your capital.</span>
      <a href="/methodology">methodology &amp; tax rules →</a>
      <a href="https://oriz.in">oriz.in</a>
    </div>
  </footer>
</Base>

<style is:global>
  /* ---- hero -------------------------------------------------------------- */
  .hero {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end;
    padding: 40px 24px 26px;
  }
  .hero-copy { max-width: 62ch; }
  .hero h1 { margin-top: 12px; }
  .hero .hl { color: var(--gold); font-style: italic; }
  .hero .sub { margin: 14px 0 0; max-width: 60ch; }
  .stat-row { display: flex; gap: 10px; margin: 0; }
  .stat {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 12px 16px; min-width: 108px; text-align: left;
  }
  .stat dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dimmer); }
  .stat dd { font-family: var(--font-disp); font-weight: 600; font-size: 26px; margin: 4px 0 0; color: var(--ink); line-height: 1; }
  .stat dd.ts { font-size: 14px; font-family: var(--font-mono); }
  .stat span { font-size: 11px; color: var(--dim); }

  /* ---- screener shell ---------------------------------------------------- */
  .scr { padding-bottom: 20px; }
  .loading { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 80px 20px; color: var(--dim); font-family: var(--font-mono); font-size: 14px; }
  .loading.err { color: var(--bad); }
  .loading .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--gold); animation: pulse 1.6s infinite; }
  .demo-banner {
    display: flex; align-items: center; gap: 10px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 14%, var(--panel)), var(--panel));
    border: 1px solid color-mix(in srgb, var(--gold) 38%, var(--line));
    border-radius: 12px; padding: 12px 16px; margin: 0 0 18px; font-size: 13.5px; color: var(--ink);
  }
  .demo-banner code { font-family: var(--font-mono); color: var(--gold-soft); }
  .demo-banner .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 var(--gold); animation: pulse 2.2s infinite; flex: 0 0 auto; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 60%, transparent); } 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); padding: 16px 18px; margin: 0 0 14px; }
  .panel h2, .phead h2 {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin: 0;
  }
  .phead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }

  /* ---- profile picker (weighting hero) ---------------------------------- */
  .profiles { margin-bottom: 18px; }
  .profiles .phead { margin-bottom: 12px; }
  .pct-hint { font-size: 11.5px; color: var(--dimmer); }
  .profile-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .profile-chip {
    font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--ink);
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px;
    padding: 9px 18px; cursor: pointer; transition: 0.15s;
  }
  .profile-chip:hover { border-color: var(--line-2); background: var(--panel-2); }
  .profile-chip.active { background: color-mix(in srgb, var(--gold) 16%, var(--bg-2)); border-color: var(--gold); color: var(--gold-soft); }
  .profile-chip.flagship .star { color: var(--gold); margin-right: 5px; }
  .profile-chip.flagship.active { box-shadow: 0 0 0 1px var(--gold); }
  .profile-chip.custom { cursor: default; font-style: italic; }
  .preset-group { display: flex; align-items: baseline; gap: 12px; margin: 0 0 10px; flex-wrap: wrap; }
  .pg-label {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--dimmer); min-width: 62px; padding-top: 4px;
  }
  .preset-group .profile-row { flex: 1; }
  .profile-blurb { color: var(--dim); font-size: 13.5px; margin: 12px 0 0; min-height: 1.3em; max-width: 90ch; }

  .grid { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 16px; align-items: start; }

  /* ---- weights panel ----------------------------------------------------- */
  .influence { display: flex; height: 26px; border-radius: 7px; overflow: hidden; margin-bottom: 14px; border: 1px solid var(--line); background: var(--bg-2); }
  .inf-seg { display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 10px; font-weight: 700; color: rgba(0,0,0,0.75); transition: width 0.2s ease; min-width: 0; overflow: hidden; }
  .wgrid { display: grid; gap: 11px; }
  .wrow { display: grid; grid-template-columns: 96px 1fr 38px; align-items: center; gap: 10px; }
  .wlab { font-family: var(--font-mono); font-size: 11.5px; color: var(--dim); display: inline-flex; align-items: center; gap: 6px; }
  .wswatch { width: 9px; height: 9px; border-radius: 2px; flex: 0 0 auto; }
  .wrow input[type=range] { width: 100%; }
  .wpct { font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--gold-soft); text-align: right; }
  .note { color: var(--dimmer); font-size: 11.5px; margin: 12px 0 0; line-height: 1.5; }

  /* ---- filter builder ---------------------------------------------------- */
  .fb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .fb-row select, .fb-row input {
    font-family: var(--font-mono); font-size: 12px; color: var(--ink);
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 9px; min-width: 0;
  }
  .fb-row select { grid-column: 1 / -1; }
  .fb-row .add { grid-column: 1 / -1; }
  .btn {
    font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: #1a1408;
    background: var(--gold); border: 0; border-radius: 8px; padding: 9px 14px; cursor: pointer; transition: 0.12s;
  }
  .btn:hover { background: var(--gold-soft); }
  .btn.ghost { background: var(--bg-2); color: var(--ink); border: 1px solid var(--line); }
  .btn.ghost:hover { border-color: var(--line-2); background: var(--panel-2); }
  .quick { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
  .q { font-family: var(--font-mono); font-size: 11px; color: var(--dim); background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px; padding: 6px 11px; cursor: pointer; }
  .q:hover { color: var(--ink); border-color: var(--line-2); }
  .q.on { background: color-mix(in srgb, var(--gold) 14%, var(--bg-2)); color: var(--gold-soft); border-color: var(--gold); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
  .chip { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: var(--ink); background: color-mix(in srgb, var(--gold) 9%, var(--bg-2)); border: 1px solid color-mix(in srgb, var(--gold) 28%, var(--line)); border-radius: 999px; padding: 4px 6px 4px 11px; }
  .chip-x { background: none; border: 0; color: var(--dim); cursor: pointer; font-size: 15px; line-height: 1; padding: 0 3px; }
  .chip-x:hover { color: var(--bad); }
  .chip-empty { color: var(--dimmer); font-family: var(--font-mono); font-size: 11px; }
  .actions { display: flex; gap: 8px; }
  .actions .btn { flex: 1; }
  .mini { font-family: var(--font-mono); font-size: 10.5px; color: var(--dim); background: var(--bg-2); border: 1px solid var(--line); border-radius: 7px; padding: 5px 10px; cursor: pointer; }
  .mini:hover { color: var(--ink); border-color: var(--line-2); }
  .mini.on { color: var(--gold-soft); border-color: var(--gold); background: color-mix(in srgb, var(--gold) 12%, var(--bg-2)); }

  /* ---- results ----------------------------------------------------------- */
  .results-bar { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
  .count { font-family: var(--font-ui); font-size: 14px; color: var(--dim); }
  .count b { font-family: var(--font-disp); font-weight: 600; font-size: 20px; color: var(--ink); }
  .rb-actions { display: flex; gap: 8px; }

  .table-scroll { max-height: 74vh; overflow: auto; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); }
  .table-scroll.static { max-height: none; overflow-x: auto; }
  table.stable { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 12.5px; }
  .stable thead th {
    position: sticky; top: 0; z-index: 3; background: var(--panel-2);
    border-bottom: 1px solid var(--line-2); padding: 0; text-align: right; white-space: nowrap;
  }
  .stable th.th-text { text-align: left; }
  .stable th.th-hero { text-align: left; z-index: 4; }
  .sort-btn {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--dim); background: none; border: 0; padding: 12px 12px; cursor: pointer; width: 100%; text-align: inherit; white-space: nowrap;
  }
  .sort-btn:hover:not(:disabled) { color: var(--ink); }
  .sort-btn.active { color: var(--gold); }
  .sort-btn:disabled { cursor: default; }
  .stable tbody td { font-family: var(--font-mono); padding: 6px 12px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--bg-2); color: var(--ink); vertical-align: middle; }
  .stable tbody tr:hover td { background: var(--bg-2); }
  .stable td.td-text { text-align: left; color: var(--dim); }
  .stable td.signed span, .stable td.signed { }

  /* hero heat cell */
  .stable td.td-hero { padding: 4px 14px 4px 12px; }
  .heat { display: grid; grid-template-columns: 30px 1fr 52px; align-items: center; gap: 10px; }
  .heat .rank { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--dimmer); text-align: right; }
  .heat .rank.t10 { color: var(--dim); }
  .heat .rank.top { color: var(--gold); font-size: 13px; }
  .heat-body { display: flex; flex-direction: column; gap: 3px; }
  .gauge { position: relative; height: 9px; background: var(--bg-2); border-radius: 5px; }
  .gauge .axis { position: absolute; left: 50%; top: -1px; bottom: -1px; width: 1px; background: var(--line-2); }
  .gauge .fill { position: absolute; top: 0; bottom: 0; border-radius: 5px; min-width: 3px; transition: width 0.25s ease, left 0.25s ease, background 0.25s ease; box-shadow: 0 0 8px -3px currentColor; }
  .drv { display: flex; height: 3px; border-radius: 2px; overflow: hidden; gap: 1px; }
  .drv-seg { min-width: 0; }
  .heat .zval { font-family: var(--font-mono); font-weight: 700; font-size: 12.5px; text-align: right; }

  /* symbol cell */
  .sym-cell { display: flex; align-items: center; gap: 8px; }
  .star-btn { background: none; border: 0; color: var(--dimmer); cursor: pointer; font-size: 15px; padding: 2px; line-height: 1; flex: 0 0 auto; }
  .star-btn.on, .star-btn:hover { color: var(--gold); }
  .sym-txt { min-width: 0; text-align: left; }
  .sym { font-family: var(--font-mono); font-weight: 600; color: var(--ink); display: flex; align-items: center; gap: 5px; }
  .sym-name { font-family: var(--font-ui); font-size: 10.5px; color: var(--dimmer); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 130px; }
  .tag-mtf, .tag-n500 { font-family: var(--font-mono); font-size: 8px; font-weight: 700; letter-spacing: 0.04em; padding: 1px 4px; border-radius: 4px; }
  .tag-mtf { color: var(--gold); background: color-mix(in srgb, var(--gold) 16%, transparent); }
  .tag-n500 { color: var(--f-momentum); background: color-mix(in srgb, var(--f-momentum) 18%, transparent); }

  .stable td.signed { color: var(--ink); }
  .rating { font-family: var(--font-mono); font-size: 10.5px; padding: 2px 6px; border-radius: 5px; }
  .r-buy, .r-strongbuy, .r-outperform { color: var(--good); background: color-mix(in srgb, var(--good) 14%, transparent); }
  .r-hold, .r-neutral { color: var(--warn); background: color-mix(in srgb, var(--warn) 14%, transparent); }
  .r-sell, .r-underperform { color: var(--bad); background: color-mix(in srgb, var(--bad) 14%, transparent); }
  .empty { padding: 40px; text-align: center; color: var(--dim); font-family: var(--font-mono); font-size: 13px; }
  .zval { font-family: var(--font-mono); font-weight: 600; }

  /* sector + compare tables */
  .sector-panel, .compare-panel { margin-top: 4px; }
  .sec-name { font-family: var(--font-ui) !important; font-weight: 600; color: var(--ink) !important; }
  .sector-table td.sym, .cmp-table .sym { color: var(--gold-soft); }
  .cmp-table th { padding: 10px 12px; text-align: right; border-bottom: 1px solid var(--line-2); vertical-align: bottom; background: var(--panel-2); }
  .cmp-sym { font-family: var(--font-mono); font-weight: 700; font-size: 13px; color: var(--ink); display: flex; align-items: center; gap: 4px; justify-content: flex-end; }
  .cmp-x { background: none; border: 0; color: var(--dimmer); cursor: pointer; font-size: 13px; padding: 0; }
  .cmp-x:hover { color: var(--bad); }
  .cmp-sec { font-family: var(--font-ui); font-size: 10px; color: var(--dimmer); }
  .cmp-metric { text-align: left !important; color: var(--dim) !important; font-family: var(--font-ui) !important; }
  .cmp-table td.best { color: var(--good); font-weight: 700; }
  .cmp-empty { display: flex; align-items: center; gap: 14px; color: var(--dim); font-size: 13.5px; }
  .cmp-empty-star { font-size: 30px; color: var(--dimmer); }
  .cmp-empty p { margin: 0; max-width: 60ch; }

  /* ---- AI card ----------------------------------------------------------- */
  .ai-card { border-color: color-mix(in srgb, var(--gold) 30%, var(--line)); background: linear-gradient(180deg, color-mix(in srgb, var(--gold) 5%, var(--panel)), var(--panel)); }
  .ai-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .ai-head h2 { color: var(--gold-soft); }
  .ai-tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; color: var(--dimmer); text-transform: uppercase; }
  .ai-daily { color: var(--ink); font-size: 14.5px; margin: 0 0 10px; }
  .ai-picks { margin: 6px 0 0; padding-left: 18px; }
  .ai-picks li { margin: 0 0 6px; font-size: 13px; color: var(--dim); }
  .ai-picks b { font-family: var(--font-mono); color: var(--gold-soft); margin-right: 4px; }
  .ai-risk { color: var(--bad); }
  .ai-scans { color: var(--f-quality, var(--gold-soft)); font-size: 12px; }

  footer .wrap span { max-width: 70ch; }

  @media (max-width: 940px) {
    .hero { grid-template-columns: 1fr; align-items: start; gap: 22px; }
    .stat-row { flex-wrap: wrap; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .controls { min-width: 0; }
    .table-scroll { max-height: 70vh; }
  }
</style>
