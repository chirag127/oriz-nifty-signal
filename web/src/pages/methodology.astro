---
import Base from '../layouts/Base.astro';

const metrics = [
  { m: 'PE (P/E)', mean: 'Price ÷ trailing earnings per share.', why: 'How many rupees you pay per rupee of annual profit.', good: 'Lower = cheaper. <15 cheap, >30 rich — but banks/utilities run low, growth runs high. Loss-makers have no meaningful PE.' },
  { m: 'PB (P/B)', mean: 'Price ÷ book value (net assets) per share.', why: 'What you pay over the accounting net worth. Best for asset-heavy names (banks, PSUs).', good: '<1 = below book. High-ROE businesses justify higher PB.' },
  { m: 'PS (P/S)', mean: 'Market cap ÷ annual sales.', why: 'Valuation independent of margin/accounting — useful when earnings are noisy or negative.', good: 'Lower cheaper; compare within a sector only.' },
  { m: 'EV/EBIT', mean: 'Enterprise value ÷ operating profit.', why: 'Capital-structure-neutral — counts debt, so a leveraged and an unleveraged firm compare fairly.', good: 'Lower cheaper. Our EV cheapness factor (keyless EV/EBITDA proper is not exposed).' },
  { m: 'P/FCF', mean: 'Market cap ÷ free cash flow.', why: 'Free cash flow is harder to fake than earnings — the cash actually left after capex.', good: 'Lower cheaper; negative FCF = excluded from the FCF factor.' },
  { m: 'PEG', mean: 'PE ÷ earnings-growth %.', why: 'Cheapness adjusted for growth — a high PE can be fair if profits are compounding.', good: '<1 = cheap for the growth. Needs positive growth + positive PE to be valid.' },
  { m: 'FCF yield', mean: 'Free cash flow ÷ market cap.', why: 'The inverse of P/FCF — the cash return on today’s price.', good: 'Higher = more cash per rupee invested. >5% is strong.' },
  { m: 'Div yield', mean: 'Dividend ÷ price.', why: 'Cash paid out. DISPLAY-ONLY here — dividends are slab-taxed, so high yield is tax-inefficient for this strategy.', good: 'Higher pays more, but drags after-tax return; kept out of the core rank.' },
  { m: 'ROE', mean: 'Net profit ÷ shareholder equity.', why: 'How well the firm turns retained capital into profit — the compounding engine.', good: '>15% good, >20% excellent. A quality gate, not a value factor.' },
  { m: 'ROCE', mean: 'Operating profit ÷ capital employed.', why: 'Return on ALL capital (debt + equity) — harder to flatter with leverage than ROE.', good: '>15% good. Should exceed cost of capital.' },
  { m: 'D/E', mean: 'Total debt ÷ equity.', why: 'Leverage. High debt magnifies both returns and the risk of a margin-call spiral under MTF.', good: '<1 comfortable; >2 risky, especially leveraged buy-and-hold.' },
  { m: 'Piotroski F', mean: '9-point fundamental-health score (see below).', why: 'One number for improving profitability, leverage and efficiency — screens value-traps.', good: '≥6 healthy, ≤3 weak.' },
  { m: 'Beta', mean: 'Sensitivity to the index.', why: 'High beta = larger drawdowns = higher margin-call risk when you’re leveraged.', good: '<1 defensive, >1.2 we exclude from the MTF preset.' },
  { m: '1Y return', mean: 'Price change over the last year.', why: 'The gross number the after-tax helper starts from.', good: 'Context only — past return is not future return.' },
];

const piotroski = [
  ['Profitability', 'ROA positive', 'Net income > 0'],
  ['Profitability', 'CFO positive', 'Operating cash flow > 0'],
  ['Profitability', 'ROA rising', 'ROA this year > last year'],
  ['Profitability', 'Accruals', 'CFO > net income (earnings backed by cash)'],
  ['Leverage / liquidity', 'Lower leverage', 'Long-term-debt ratio down YoY'],
  ['Leverage / liquidity', 'Current ratio up', 'Current assets / liabilities improved'],
  ['Leverage / liquidity', 'No dilution', 'Shares outstanding did not rise'],
  ['Efficiency', 'Margin up', 'Gross (or operating) margin rose YoY'],
  ['Efficiency', 'Turnover up', 'Asset turnover (sales / assets) rose YoY'],
];
---

