---
import Base from '../layouts/Base.astro';
import { PRESETS, type PresetGroup } from '../lib/scoring';

const opSym = (o: string) => ({ '>=': '≥', '<=': '≤', '>': '>', '<': '<', between: '–' }[o] ?? o);
const ruleText = (p: typeof PRESETS[number]): string => {
  const parts: string[] = [];
  for (const fl of p.flags || []) parts.push(fl === 'mtf_eligible' ? 'MTF/F&O-eligible' : fl === 'n500' ? 'Nifty-500' : 'quality-flag');
  for (const f of p.filters || []) parts.push(`${f.field} ${opSym(f.op)} ${f.a}${f.op === 'between' ? '–' + (f.b ?? '') : ''}`);
  const filt = parts.length ? parts.join(' · ') : 'no filter — whole universe';
  return `${filt} — sort ${p.sort!.id} ${p.sort!.desc ? '↓' : '↑'}`;
};
const groups: PresetGroup[] = ['Core', 'Named', 'Strategy'];

const metrics = [
  { m: 'PE (P/E)', mean: 'Price ÷ trailing earnings per share.', why: 'How many rupees you pay per rupee of annual profit.', good: 'Lower = cheaper. <15 cheap, >30 rich — but banks/utilities run low, growth runs high. Loss-makers have no meaningful PE.' },
  { m: 'PB (P/B)', mean: 'Price ÷ book value (net assets) per share.', why: 'What you pay over the accounting net worth. Best for asset-heavy names (banks, PSUs).', good: '<1 = below book. High-ROE businesses justify higher PB.' },
  { m: 'PS (P/S)', mean: 'Market cap ÷ annual sales.', why: 'Valuation independent of margin/accounting — useful when earnings are noisy or negative.', good: 'Lower cheaper; compare within a sector only.' },
  { m: 'EV/EBIT', mean: 'Enterprise value ÷ operating profit.', why: 'Capital-structure-neutral — counts debt, so a leveraged and an unleveraged firm compare fairly.', good: 'Lower cheaper. Our EV cheapness factor (keyless EV/EBITDA proper is not exposed).' },
  { m: 'P/FCF', mean: 'Market cap ÷ free cash flow.', why: 'Free cash flow is harder to fake than earnings — the cash actually left after capex.', good: 'Lower cheaper; negative FCF = excluded from the FCF factor.' },
  { m: 'PEG', mean: 'PE ÷ earnings-growth %.', why: 'Cheapness adjusted for growth — a high PE can be fair if profits are compounding.', good: '<1 = cheap for the growth. Needs positive growth + positive PE to be valid.' },
  { m: 'FCF yield', mean: 'Free cash flow ÷ market cap.', why: 'The inverse of P/FCF — the cash return on today’s price.', good: 'Higher = more cash per rupee invested. >5% is strong.' },
  { m: 'Div yield', mean: 'Dividend ÷ price.', why: 'Cash paid out. DISPLAY-ONLY here — dividends are slab-taxed, so high yield is tax-inefficient for this strategy.', good: 'Higher pays more, but drags after-tax return; kept out of the core rank.' },
  { m: 'ROE', mean: 'Net profit ÷ shareholder equity.', why: 'How well the firm turns retained capital into profit — the compounding engine.', good: '>15% good, >20% excellent. A quality gate, not a value factor.' },
  { m: 'ROCE', mean: 'Operating profit ÷ capital employed.', why: 'Return on ALL capital (debt + equity) — harder to flatter with leverage than ROE.', good: '>15% good. Should exceed cost of capital.' },
  { m: 'D/E', mean: 'Total debt ÷ equity.', why: 'Leverage. High debt magnifies both returns and the risk of a margin-call spiral under MTF.', good: '<1 comfortable; >2 risky, especially leveraged buy-and-hold.' },
  { m: 'Piotroski F', mean: '9-point fundamental-health score (see below).', why: 'One number for improving profitability, leverage and efficiency — screens value-traps.', good: '≥6 healthy, ≤3 weak.' },
  { m: 'Beta', mean: 'Sensitivity to the index.', why: 'High beta = larger drawdowns = higher margin-call risk when you’re leveraged.', good: '<1 defensive, >1.2 we exclude from the MTF preset.' },
  { m: '1Y return', mean: 'Price change over the last year.', why: 'The gross number the after-tax helper starts from.', good: 'Context only — past return is not future return.' },
];

const piotroski = [
  ['Profitability', 'ROA positive', 'Net income > 0'],
  ['Profitability', 'CFO positive', 'Operating cash flow > 0'],
  ['Profitability', 'ROA rising', 'ROA this year > last year'],
  ['Profitability', 'Accruals', 'CFO > net income (earnings backed by cash)'],
  ['Leverage / liquidity', 'Lower leverage', 'Long-term-debt ratio down YoY'],
  ['Leverage / liquidity', 'Current ratio up', 'Current assets / liabilities improved'],
  ['Leverage / liquidity', 'No dilution', 'Shares outstanding did not rise'],
  ['Efficiency', 'Margin up', 'Gross (or operating) margin rose YoY'],
  ['Efficiency', 'Turnover up', 'Asset turnover (sales / assets) rose YoY'],
];
---

<Base
  active="methodology"
  title="Methodology & tax rules — how the return-potential composite + MTF screener works | Nifty Signal"
  desc="The source of truth: every metric explained, the composite formula, the weighting profiles, the Piotroski 9-point breakdown, the MTF 1-year buy-and-hold rationale, and the full India equity tax section (LTCG 12.5% vs STCG 20%, exemption, dividend drag, churn-after-12-months)."
>
  <header class="top wrap wrap-narrow">
    <span class="kicker">the source of truth</span>
    <h1>How this works</h1>
    <p class="sub">Every metric, the composite formula, the weighting profiles, the Piotroski breakdown, the MTF strategy, and the full tax logic. Plain language. This page — not a README — is the methodology of record.</p>
  </header>

  <main class="wrap wrap-narrow doc">
    <nav class="toc panel">
      <a href="#composite">Value composite</a>
      <a href="#profiles">Presets &amp; scans</a>
      <a href="#metrics">Every metric</a>
      <a href="#piotroski">Piotroski 9-pt</a>
      <a href="#value-quality">Value vs quality</a>
      <a href="#mtf">MTF 1-yr strategy</a>
      <a href="#tax">Tax rules</a>
      <a href="#disclaimer">Disclaimer</a>
    </nav>

    <section id="composite" class="panel">
      <h2>The value composite — what Screener.in doesn’t give you</h2>
      <p>Screener.in shows metrics one at a time; it can’t rank the whole market by a single blended cheapness score. That blended score is the point of this site. It runs in two layers:</p>
      <p><b>1 · Value composite (percentile-ranked).</b> Each cheapness factor is turned into a <b>yield</b> (so higher = cheaper), then <b>percentile-ranked 0–100 across the whole investable universe</b> — the 90th percentile means cheaper than 90% of stocks on that factor. The value score is the equal-weight mean of the percentiles the stock has:</p>
      <pre class="formula">value factors = E/P, B/P, S/P, EBITDA/EV, FCF-yield   (div-yield display-only)

per factor:  yield      = 1 / ratio                    (E/P = 1/PE, etc.)
             pct[f]      = percentile-rank of yield across the universe (0–100, higher=cheaper)

value_score = mean( pct[f]  for each factor f the stock HAS )   (≥2 factors required)</pre>
      <p>Percentile (not raw z-score) is used so one extreme outlier can’t distort the scale — every stock sits on a clean 0–100 ladder. A value_score of 97 means the stock is in the cheapest ~3% of the market on its available factors.</p>
      <p><b>2 · Return-potential composite (weighted sub-scores).</b> Five sub-scores — <b>Value, Growth, Quality, Momentum, Analyst</b> — feed a weighted mean, renormalised over the sub-scores the stock actually has. Growth/quality/momentum/analyst are cross-sectional z-means; the 0–100 value percentile is mapped onto the same z scale (50th→0, ~90th→+2) so the blend is apples-to-apples:</p>
      <pre class="formula">subs = value · growth · quality · momentum · analyst

composite = Σ( wₖ · subₖ )  /  Σ( wₖ )     over present subs
higher composite = higher return potential</pre>
      <h3>Live re-weighting</h3>
      <p>The JSON ships each stock’s sub-scores, so the sliders <b>recompute the composite in your browser</b> with no refetch. The <b>diverging heat gauge</b> in the rank column shows the composite (teal = below-average, gold = above), and the thin strip under it shows <b>which factors drove the score</b>.</p>
      <h3>Missing-value handling</h3>
      <p>A factor only counts when valid and positive. A stock missing a factor is averaged over the rest — never penalised with a zero. Coverage thins on small/micro caps.</p>
      <h3>Loss-maker exclusion</h3>
      <p>Negative or zero earnings and negative book don’t produce a valid yield, so <b>loss-makers never score “cheap.”</b></p>
    </section>

    <section id="profiles" class="panel">
      <h2>Presets — 12 curated scans &amp; weightings</h2>
      <p>Every preset sets the <b>filters + the sort</b> (and, for the weighting ones, the factor sliders), then surfaces the <b>top ~100</b> so you narrow to your final 5. Grouped Core / Named / Strategy. <b>My Deep Value</b> loads by default. Exact rule for each:</p>
      {groups.map((g) => (
        <>
          <h3>{g}</h3>
          <table class="mtable prof-table">
            <thead><tr><th>Preset</th><th>What it screens</th><th>Exact rule</th></tr></thead>
            <tbody>
              {PRESETS.filter((p) => p.group === g).map((p) => (
                <tr>
                  <td class="m">{p.label}{p.flagship ? ' ★' : ''}{p.id === 'my_deep_value' ? ' (default)' : ''}</td>
                  <td>{p.blurb}</td>
                  <td class="rule">{ruleText(p)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))}
      <h3>My Deep Value — the default &amp; its value-trap guard</h3>
      <p>The screen opens on <b>My Deep Value</b>: <code>PE &lt; 6 AND PB &lt; 1.5</code>, sorted cheapest-first. Cheap alone catches value-traps, so a <b>quality guard</b> is documented as the intended filter — keep names where <b>ROE &gt; 12% OR Piotroski F ≥ 6 OR D/E &lt; 1</b> — to drop the obvious traps inside the cheap tail while staying deliberately wide. The Value, Graham and net-net cheapness rungs stack on top for tighter cuts.</p>
      <h3>Named-scan definitions</h3>
      <ul>
        <li><b>Graham defensive</b> — PE &lt; 15, PB &lt; 1.5, PE×PB &lt; 22.5, D/E &lt; 1. All four rungs must pass (the <code>graham_ok</code> flag).</li>
        <li><b>Magic Formula (Greenblatt)</b> — rank the universe by earnings-yield (EBIT/EV) and separately by ROCE, sum the two ranks, re-rank; <code>magic_rank</code> = 1 is best. Sorted ascending.</li>
        <li><b>Piotroski</b> — the 9-point health score (below); the scan keeps <b>F ≥ 7</b>. Computed on the liquid enriched shortlist, so coverage is intentionally narrow.</li>
        <li><b>GARP</b> — PEG &lt; 1 with ROE &gt; 15% and positive EPS growth: growth you’re not overpaying for.</li>
        <li><b>FII/DII Accumulation</b> — combined institutional stake (FII + DII) ≥ 25% and cheap (value ≥ 60th pct): following smart money into cheap names.</li>
        <li><b>High FCF-Yield</b> — lowest P/FCF (the most free cash per rupee of price).</li>
      </ul>
    </section>

    <section id="metrics" class="panel">
      <h2>Every metric — plain language</h2>
      <table class="mtable">
        <thead><tr><th>Metric</th><th>What it is</th><th>Why it matters</th><th>What cheap / good looks like</th></tr></thead>
        <tbody>
          {metrics.map((r) => (
            <tr>
              <td class="m">{r.m}</td>
              <td>{r.mean}</td>
              <td>{r.why}</td>
              <td>{r.good}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section id="piotroski" class="panel">
      <h2>Piotroski F-score — 9 points</h2>
      <p>One point per test that passes, comparing this financial year to the last. It screens value-traps: a cheap stock with a rising F-score is improving; a cheap stock with a falling one is often cheap for a reason. A test whose data is missing is <b>skipped, never faked</b> — the row also reports how many of the 9 were computable.</p>
      <table class="mtable">
        <thead><tr><th>Group</th><th>Test</th><th>Passes when</th></tr></thead>
        <tbody>
          {piotroski.map((r) => (<tr><td class="m">{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}
        </tbody>
      </table>
    </section>

    <section id="value-quality" class="panel">
      <h2>Value vs quality</h2>
      <p><b>Value</b> is cheapness (the composite). <b>Quality</b> is business strength — ROE, ROCE, Piotroski, low debt. They’re kept separate on purpose:</p>
      <ul>
        <li>The primary rank is <b>pure value</b>, so genuinely cheap names surface even if unglamorous.</li>
        <li>A <b>Quality flag</b> (ROE&gt;15% &amp; ROCE&gt;15% &amp; Piotroski≥6 &amp; D/E&lt;1.5) marks the strong businesses.</li>
        <li>Cheap <b>and</b> quality = the sweet spot; cheap <b>without</b> quality = possible value-trap. The <b>Quality-Value</b> preset intersects both (value ≥70th pct, ROE&gt;15%, D/E&lt;1).</li>
      </ul>
    </section>

    <section id="mtf" class="panel">
      <h2>The MTF 1-year buy-and-hold strategy</h2>
      <p><b>MTF</b> (Margin Trading Facility) lets you hold a leveraged long position and pay interest (~12%/yr assumed here) rather than square off intraday. This screener is tuned for buying quality-value on margin, <b>holding just over 12 months, then rebalancing annually</b>. Why the 12-month hold and annual churn:</p>
      <ul>
        <li><b>Tax</b> — a hold past 12 months converts the gain from STCG (20%) to LTCG (12.5%). The annual churn is deliberately LTCG-optimal.</li>
        <li><b>Interest drag</b> — you must clear ~12%/yr just to break even on the borrowed portion. The <b>after-tax 1Y</b> column subtracts it: <code>1Y return − MTF interest − LTCG on the gain</code>. A name that doesn’t clear interest is a losing leveraged trade even if the stock rose.</li>
        <li><b>Margin-call risk</b> — leverage magnifies drawdowns; a sharp fall can force liquidation at the worst time. Hence the preset caps <b>beta ≤ 1.2</b> and tilts to quality.</li>
        <li><b>Value-trap risk</b> — cheap + weak fundamentals can stay cheap for years while interest accrues. The quality tilt + Piotroski guard against it.</li>
      </ul>
      <p>The <b>MTF Buy-Hold 1yr</b> preset (flagship) restricts to MTF-eligible, β ≤ 1.2 names and ranks by <b>after-tax, after-interest 1Y return</b> — not gross return.</p>
    </section>

    <section id="tax" class="panel tax">
      <h2>Tax rules (India equity) — lowest-tax by design</h2>
      <p>This strategy targets the <b>lowest tax drag</b>. The rules baked into the after-tax column and the presets:</p>
      <ul>
        <li><b>LTCG vs STCG</b> — hold &gt;12 months → long-term capital gains at <b>12.5%</b>. Sell inside 12 months → short-term at <b>20%</b>. Holding past a year nearly halves the tax; the annual churn is timed for it.</li>
        <li><b>₹1.25L LTCG exemption/yr</b> — the first ₹1.25 lakh of long-term gains each year is tax-free. Harvesting gains up to the threshold realises them at 0% tax.</li>
        <li><b>Dividend drag</b> — dividends are taxed at your <b>slab rate</b> (up to ~30%+). For a high earner, a high-dividend stock is tax-inefficient, so div-yield is <b>display-only</b>, kept out of the core rank; high-div names are flagged as tax-inefficient for this strategy.</li>
        <li><b>MTF interest deductibility</b> — interest paid on the margin facility <i>may</i> offset gains under a business-income treatment. Informational only, depends on how you file — not tax advice.</li>
        <li><b>Churn after 12 months</b> — rebalance just past the one-year mark so every realised gain is LTCG, not STCG.</li>
        <li><b>Tax-loss harvesting</b> — before the annual churn, book losers to offset the winners’ gains and cut the net taxable amount.</li>
      </ul>
      <p class="taxnote">Rates reflect the current India LTCG/STCG regime for listed equity. Verify against the latest Finance Act and your own situation before acting.</p>
    </section>

    <section id="disclaimer" class="panel disc">
      <h2>Disclaimer</h2>
      <p><b>Not investment or tax advice.</b> This is an educational screen, not a recommendation. Low multiples don’t make a stock cheap in reality; a high composite is a starting point for research, not a buy signal. PSUs are cyclical and policy-exposed — they dominate low-PE screens for reasons that don’t always reverse. Leverage (MTF) can lose more than your capital. Data is best-effort from keyless public sources and can be stale, partial, or wrong. Do your own research; consult a registered adviser and a tax professional.</p>
    </section>
  </main>

  <footer>
    <div class="wrap wrap-narrow">
      <a href="/screener">← back to the screener</a> · Not investment/tax advice · <a href="https://oriz.in">oriz.in</a>
    </div>
  </footer>
</Base>

