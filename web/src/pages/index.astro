---
import Base from '../layouts/Base.astro';
import { loadMetrics } from '../lib/screener';
import { PROFILES } from '../lib/scoring';

const data = loadMetrics();
const count = (data.count ?? data.stocks.length).toLocaleString('en-IN');
---

<Base active="signal">
  <header class="lp-hero wrap">
    <span class="kicker">nifty.oriz.in · Indian equity intelligence</span>
    <h1>The market, ranked by<br /><span class="hl">return potential</span>.</h1>
    <p class="sub">A backend-free screener over <b>{count}</b> listed Indian stocks. One composite blends value, growth, quality, momentum and analyst upside — pick a weighting profile, re-weight the factors live, share the exact screen by URL.</p>
    <div class="cta">
      <a class="btn-lg" href="/screener">Open the screener →</a>
      <a class="btn-lg ghost" href="/methodology">How it works</a>
    </div>
  </header>

  <main class="wrap">
    <section class="cards">
      <article class="card">
        <span class="cn">01</span>
        <h3>A single return-potential score</h3>
        <p>Screener.in shows metrics one at a time. Here every stock gets one blended composite — the differentiator — visualised as a diverging heat gauge, not a bare number.</p>
      </article>
      <article class="card">
        <span class="cn">02</span>
        <h3>Weighting profiles you control</h3>
        <p>Factor weights shown as a normalised % of influence. Ship-ready profiles tilt the mix, or drag the sliders for your own — the ranking recomputes live in your browser.</p>
        <ul class="prof-list">
          {PROFILES.map((p) => <li><b>{p.label}</b> — {p.blurb}</li>)}
        </ul>
      </article>
      <article class="card">
        <span class="cn">03</span>
        <h3>Tuned for MTF buy-and-hold</h3>
        <p>An after-tax, after-interest 1-year column subtracts ~12% MTF interest and 12.5% LTCG, so you see the leveraged, taxed return — not the gross one. Full tax logic on the methodology page.</p>
      </article>
    </section>

    <section class="strip">
      <div><b>Filter builder</b><span>any metric, sector, MTF-eligible, Nifty 500</span></div>
      <div><b>Watchlist &amp; compare</b><span>star up to 8, side-by-side</span></div>
      <div><b>Sector view</b><span>medians + strongest name per sector</span></div>
      <div><b>CSV export &amp; shareable URL</b><span>the whole screen, portable</span></div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>Not investment or tax advice — an educational screen. Data best-effort from keyless public sources.</span>
      <a href="/screener">screener →</a>
      <a href="https://oriz.in">oriz.in</a>
    </div>
  </footer>
</Base>

<style>
  .lp-hero { text-align: center; padding: 70px 24px 40px; }
  .lp-hero h1 { margin: 14px auto 0; }
  .lp-hero .hl { color: var(--gold); font-style: italic; }
  .lp-hero .sub { color: var(--dim); font-size: 17px; max-width: 60ch; margin: 18px auto 0; }
  .cta { display: flex; gap: 12px; justify-content: center; margin: 30px 0 0; flex-wrap: wrap; }
  .btn-lg {
    font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: #1a1408;
    background: var(--gold); border-radius: 10px; padding: 13px 26px; transition: 0.12s;
  }
  .btn-lg:hover { background: var(--gold-soft); }
  .btn-lg.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line-2); }
  .btn-lg.ghost:hover { border-color: var(--gold); color: var(--gold-soft); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 28px 0 16px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 24px 22px; position: relative; }
  .card .cn { font-family: var(--font-mono); font-size: 11px; color: var(--gold); letter-spacing: 0.1em; }
  .card h3 { font-family: var(--font-disp); font-weight: 600; font-size: 20px; margin: 8px 0 8px; letter-spacing: -0.01em; }
  .card p { color: var(--dim); font-size: 14px; margin: 0; }
  .prof-list { list-style: none; margin: 14px 0 0; padding: 0; }
  .prof-list li { font-size: 12px; color: var(--dim); padding: 5px 0; border-top: 1px solid var(--line); }
  .prof-list b { font-family: var(--font-mono); color: var(--ink); font-size: 11.5px; }

  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 16px 0 20px; }
  .strip div { background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
  .strip b { font-family: var(--font-disp); font-weight: 600; font-size: 15px; display: block; }
  .strip span { font-size: 12px; color: var(--dim); }

  footer .wrap { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  footer a { color: var(--gold); }

  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
    .strip { grid-template-columns: 1fr 1fr; }
  }
</style>
