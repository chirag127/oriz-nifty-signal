---
import type { Indicator } from '../lib/data';
interface Props {
  ind: Indicator;
}
const { ind } = Astro.props;

// score 0..100 buy-attractiveness -> bar fill + colour along the traffic light
const s = ind.score ?? 0;
const color =
  s >= 70 ? 'var(--buy)' : s >= 55 ? 'var(--accum)' : s >= 40 ? 'var(--hold)' : 'var(--caution)';
const na = ind.value === null;
const fmt = (n: number) =>
  ind.unit === '%' ? `${n}%` : ind.unit === 'x' ? `${n}x` : `${n}`;
---

<div class={`ind${na ? ' na' : ''}`}>
  <div class="row">
    <span class="lab">{ind.label}</span>
    <span class="val" style={`color:${na ? 'var(--dimmer)' : color}`}>
      {na ? 'n/a' : fmt(ind.value as number)}
    </span>
  </div>
  <div class="meta">
    <span class="zone" style={`color:${na ? 'var(--dimmer)' : color}`}>{na ? 'source unavailable' : ind.zone}</span>
    <span class="detail">{ind.detail}</span>
  </div>
  <div class="track">
    <div class="fill" style={`width:${na ? 0 : s}%;background:${color}`}></div>
  </div>
  <div class="foot">
    <span>{ind.source}{ind.as_of ? ` · ${ind.as_of}` : ''}</span>
    <span>{na ? '' : `${s.toFixed(0)}/100 buy score`}</span>
  </div>
</div>

<style>
  .ind {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .ind.na { opacity: 0.6; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .lab { font-family: var(--font-ui); font-weight: 600; font-size: 14px; }
  .val { font-family: var(--font-mono); font-weight: 600; font-size: 22px; }
  .meta { display: flex; justify-content: space-between; gap: 10px; margin: 2px 0 10px; }
  .zone {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .detail { color: var(--dim); font-size: 12px; text-align: right; }
  .track { height: 8px; border-radius: 6px; background: var(--bg-2); overflow: hidden; }
  .fill { height: 100%; border-radius: 6px; transition: width 0.3s ease; }
  .foot {
    display: flex; justify-content: space-between; margin-top: 8px;
    font-family: var(--font-mono); font-size: 10px; color: var(--dimmer);
    letter-spacing: 0.04em;
  }
</style>
