---
import type { HistPoint } from '../lib/data';
interface Props {
  points: HistPoint[];
}
const { points } = Astro.props;
const W = 820;
const H = 90;
const PAD = 6;

let path = '';
let area = '';
let last: { x: number; y: number } | null = null;
if (points.length > 1) {
  const x = (i: number) => PAD + (i / (points.length - 1)) * (W - 2 * PAD);
  // score is always 0..100
  const y = (val: number) => PAD + (1 - val / 100) * (H - 2 * PAD);
  const coords = points.map((p, i) => ({ x: x(i), y: y(p.score) }));
  path = coords.map((c, i) => `${i ? 'L' : 'M'} ${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');
  area = `${path} L ${coords[coords.length - 1].x.toFixed(1)} ${H - PAD} L ${coords[0].x.toFixed(1)} ${H - PAD} Z`;
  last = coords[coords.length - 1];
}
---

{points.length > 1 ? (
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" height={H} preserveAspectRatio="none" aria-label="Buy-signal score history">
    <defs>
      <linearGradient id="sig" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4ea6ff" stop-opacity="0.30" />
        <stop offset="100%" stop-color="#4ea6ff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d={area} fill="url(#sig)" />
    <path d={path} fill="none" stroke="#4ea6ff" stroke-width="2" stroke-linejoin="round" />
    {last && <circle cx={last.x} cy={last.y} r="3.5" fill="#4ea6ff" />}
  </svg>
) : (
  <p style="color:var(--dim);font-size:13px;margin:0">History builds as the signal runs each day.</p>
)}
