---
// Signature element: a trading-desk traffic light. Four lamps stacked; the one
// matching the verdict is lit, the rest dimmed. This is the site's identity —
// not a dial, not a ledger.
interface Props {
  verdict: string;
  score: number;
}
const { verdict, score } = Astro.props;

const LAMPS = [
  { label: 'STRONG BUY', color: 'var(--buy)' },
  { label: 'ACCUMULATE', color: 'var(--accum)' },
  { label: 'HOLD-SIP-ONLY', color: 'var(--hold)' },
  { label: 'CAUTION', color: 'var(--caution)' },
];
---

<div class="signal-light" role="img" aria-label={`Verdict ${verdict}, score ${score} of 100`}>
  {LAMPS.map((l) => {
    const on = l.label === verdict;
    return (
      <div class={`lamp${on ? ' on' : ''}`} style={on ? `--lit:${l.color}` : ''}>
        <span class="dot"></span>
        <span class="txt">{l.label}</span>
      </div>
    );
  })}
</div>

<style>
  .signal-light {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }
  .lamp {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--bg-2);
    opacity: 0.42;
  }
  .lamp .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--dimmer);
    flex: none;
  }
  .lamp .txt {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--dim);
  }
  .lamp.on {
    opacity: 1;
    background: color-mix(in srgb, var(--lit) 12%, var(--bg-2));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lit) 40%, transparent);
  }
  .lamp.on .dot {
    background: var(--lit);
    box-shadow: 0 0 14px 2px color-mix(in srgb, var(--lit) 70%, transparent);
  }
  .lamp.on .txt {
    color: var(--lit);
    font-weight: 600;
  }
</style>
